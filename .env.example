# Portfolio Configuration

# Contact Form Setup
# Option 1: Using FormSubmit (free, no backend needed)
# Go to https://formsubmit.co and set up your email
VITE_FORM_SUBMIT_EMAIL=your-email@example.com

# Option 2: Using Netlify Forms (if deploying to Netlify)
# Netlify automatically handles form submissions

# Option 3: Using your own backend
# Set up your API endpoint if using a custom backend
VITE_FORM_API_ENDPOINT=https://your-api.com/contact

# Social Links (update with your actual profiles)
VITE_GITHUB_URL=https://github.com/awwdrsh
VITE_LINKEDIN_URL=https://linkedin.com/in/aadarshcybersecurity
VITE_TWITTER_URL=https://twitter.com/awwdrsh
VITE_CV_URL=https://example.com/cv-aadarsh.pdf

# Site Configuration
VITE_SITE_URL=https://yourportfolio.com
VITE_SITE_TITLE=Alee | Cybersecurity Portfolio
